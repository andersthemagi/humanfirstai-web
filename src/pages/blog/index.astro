---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title="Writing" description="Essays from the people behind Human First AI.">
  <header class="wrap page-head">
    <h1>Writing</h1>
    <p class="lead">What we are thinking about while we get the first workshop going.</p>
  </header>

  <div class="wrap posts">
    <ul class="posts__list">
      {
        posts.map((post) => {
          const external = Boolean(post.data.externalUrl);
          return (
            <li>
              <p class="posts__meta">
                <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
              </p>
              <div>
                <h2>
                  <a href={post.data.externalUrl ?? `/blog/${post.id}/`}>
                    {post.data.title}
                    {external && (
                      <>
                        <Arrow external />
                        <span class="visually-hidden"> (opens on our articles site)</span>
                      </>
                    )}
                  </a>
                </h2>
                {post.data.subtitle && <p class="posts__sub">{post.data.subtitle}</p>}
                <p class="posts__by">{post.data.author}</p>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</Base>

<style>
  .posts {
    padding-bottom: var(--section);
  }
  .posts__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 2px solid var(--hf-ink);
  }
  .posts__list li {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 8px 40px;
    padding-block: 36px;
    border-top: 2px solid var(--hf-ink);
  }
  .posts__meta {
    padding-top: 0.5em;
    font: 600 var(--size-small) / 1.4 var(--font-brand);
    color: var(--hf-text-muted);
  }
  .posts__list h2 {
    font-size: var(--size-headline);
    max-width: 22em;
  }
  .posts__list h2 a {
    color: var(--hf-text);
    text-decoration: none;
  }
  .posts__list h2 a:hover {
    color: var(--hf-sunrise-deep);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .posts__list h2 :global(.arrow) {
    display: inline-block;
    width: 0.6em;
    height: 0.6em;
    margin-left: 0.15em;
    vertical-align: 0.05em;
  }
  .posts__sub {
    margin-top: 8px;
    font-size: var(--size-lead);
  }
  .posts__by {
    margin-top: 12px;
    font-size: var(--size-small);
  }
  @media (max-width: 720px) {
    .posts__list li {
      grid-template-columns: 1fr;
    }
  }
</style>
