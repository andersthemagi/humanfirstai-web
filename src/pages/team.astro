---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const people = await Promise.all(
  (await getCollection('team'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (person) => ({ ...person, Content: (await render(person)).Content, hasBio: Boolean(person.body?.trim()) })),
);
---

<Base title="Team" description="The people starting Human First AI.">
  <header class="wrap page-head">
    <h1>Who is behind this</h1>
    <p class="lead">
      {people.length} people so far, in different cities, doing this alongside day jobs. We are writing, planning the
      first workshop, and looking for more hands.
    </p>
  </header>

  <div class="wrap team">
    <ul class="team__row">
      {
        people.map((p) => (
          <li class="person">
            <div class="person__arch">
              {p.data.photo ? (
                <img src={p.data.photo} alt={p.data.photoAlt ?? ''} width="400" height="400" loading="lazy" />
              ) : (
                <span class="person__initial" aria-hidden="true">
                  {p.data.name.charAt(0)}
                </span>
              )}
            </div>
            <h2 class="person__name">{p.data.name}</h2>
            {p.data.role && <p class="person__role">{p.data.role}</p>}
            {p.data.location && <p class="person__place">{p.data.location}</p>}
            {p.hasBio && (
              <div class="person__bio">
                <p.Content />
              </div>
            )}
            {p.data.link && (
              <a class="person__link" href={p.data.link}>
                More about {p.data.name.split(' ')[0]}
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <aside class="team__join">
      <h2>There is room for you</h2>
      <p>
        We need people who can teach patiently, translate, organise a room, take photographs, or just turn up. No
        experience with AI required.
      </p>
      <a class="btn" href="/contact/?reason=help">I would like to help</a>
    </aside>
  </div>
</Base>

<style>
  .team {
    padding-bottom: var(--section);
  }
  .team__row {
    list-style: none;
    margin: 0;
    padding: 0 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 56px clamp(20px, 3vw, 40px);
  }
  /* Portraits sit in the threshold arch: width : springline : radius = 30 : 21.5 : 15. */
  .person__arch {
    position: relative;
    aspect-ratio: 30 / 36.5;
    border-radius: 50% 50% 0 0 / 41.1% 41.1% 0 0;
    overflow: hidden;
    background: var(--hf-sky);
  }
  .person__arch img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .person__arch::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 6px;
    background: var(--hf-ink);
  }
  .person__initial {
    display: grid;
    place-items: center;
    height: 100%;
    font: 800 clamp(72px, 9vw, 112px) / 1 var(--font-brand);
    letter-spacing: -0.04em;
    color: var(--hf-ink);
  }
  .person__name {
    margin-top: 20px;
    font-size: var(--size-title);
  }
  .person__role {
    margin-top: 4px;
    font: 600 var(--size-small) / 1.4 var(--font-brand);
    color: var(--hf-sunrise-deep);
  }
  .person__place {
    font-size: var(--size-small);
    color: var(--hf-text-muted);
  }
  .person__bio {
    margin-top: 12px;
  }
  .person__link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }

  .team__join {
    margin-top: var(--section);
    padding-top: 40px;
    border-top: 2px solid var(--hf-ink);
    display: grid;
    grid-template-columns: 1fr 1.2fr auto;
    gap: 20px 48px;
    align-items: start;
  }
  .team__join p {
    max-width: 38ch;
  }
  @media (max-width: 820px) {
    .team__join {
      grid-template-columns: 1fr;
    }
    .team__join .btn {
      justify-self: start;
    }
  }
</style>
