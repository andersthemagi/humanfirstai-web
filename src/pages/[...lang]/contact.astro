---
import Base from '../../layouts/Base.astro';
import { fill, langOf, langPaths, localPath, useT } from '../../i18n/ui';

export const getStaticPaths = langPaths;

const lang = langOf(Astro.url);
const t = useT(lang).contact;
// The values are what arrives with the message; only the labels change with the language.
const reasons = (['help', 'host', 'press', 'other'] as const).map((value) => ({ value, label: t.reasons[value] }));
---

<Base title={t.title} description={t.description} takePart={false}>
  <header class="wrap page-head">
    <h1>{t.heading}</h1>
    <p class="lead">{t.lead}</p>
  </header>

  <div class="wrap contact">
    <form
      class="contact__form"
      name="contact"
      method="POST"
      action={localPath(lang, '/thanks/')}
      data-netlify="true"
      netlify-honeypot="company"
    >
      <input type="hidden" name="form-name" value="contact" />
      {/* So we can write back in the language the person was reading. */}
      <input type="hidden" name="language" value={lang} />
      <p class="visually-hidden">
        <label>{useT(lang).news.honeypot} <input name="company" tabindex="-1" autocomplete="off" /></label>
      </p>

      <fieldset class="field reasons">
        <legend>{t.legend}</legend>
        <div class="reasons__grid">
          {
            reasons.map((r) => (
              <label class="reason">
                <input type="radio" name="reason" value={r.value} required />
                <span>{r.label}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="contact__pair">
        <div class="field">
          <label for="c-name">{t.name}</label>
          <input id="c-name" type="text" name="name" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="c-email">{t.email}</label>
          <input id="c-email" type="email" name="email" autocomplete="email" required />
        </div>
      </div>

      <div class="field">
        <label for="c-message">{t.message}</label>
        <p class="contact__hint" id="c-message-hint">{t.hint}</p>
        <textarea id="c-message" name="message" required aria-describedby="c-message-hint"></textarea>
      </div>

      <div class="contact__send">
        <button class="btn" type="submit">{t.send}</button>
        <p class="contact__hint" set:html={fill(t.use, { privacy: localPath(lang, '/privacy/') })} />
      </div>
    </form>
  </div>
</Base>

<style>
  .contact {
    padding-bottom: var(--section);
  }
  .contact__form {
    display: grid;
    gap: 28px;
    max-width: 760px;
  }
  .contact__send {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }
  .contact__hint {
    font-size: var(--size-small);
    color: var(--hf-text-muted);
  }
  .contact__hint :global(a) {
    color: inherit;
  }
  .reasons {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .reasons legend {
    margin-bottom: 12px;
  }
  .reasons__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 10px;
  }
  .reason {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    padding: 12px 16px;
    border: 2px solid var(--hf-border);
    border-radius: var(--radius);
    background: var(--hf-white);
    font: 600 16px/1.3 var(--font-brand);
    cursor: pointer;
    transition:
      border-color 150ms var(--ease-out),
      background-color 150ms var(--ease-out);
  }
  .reason:hover {
    border-color: var(--hf-ink);
  }
  .reason:has(input:checked) {
    border-color: var(--hf-ink);
    background: var(--hf-sunrise);
  }
  .reason input {
    width: 20px;
    height: 20px;
    margin: 0;
    accent-color: var(--hf-ink);
  }
  .contact__pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  @media (max-width: 640px) {
    .contact__pair {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Links like /contact/?reason=host arrive with the right option chosen.
  const reason = new URLSearchParams(location.search).get('reason');
  if (reason) {
    const input = document.querySelector<HTMLInputElement>(`input[name="reason"][value="${CSS.escape(reason)}"]`);
    if (input) input.checked = true;
  }
</script>
