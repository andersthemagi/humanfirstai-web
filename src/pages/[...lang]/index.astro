---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Door from '../../components/Door.astro';
import Arrow from '../../components/Arrow.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { entryId, fill, langOf, langPaths, localPath, useT } from '../../i18n/ui';

export const getStaticPaths = langPaths;

const lang = langOf(Astro.url);
const t = useT(lang).home;
// Links written in the content ("/contact/?reason=help", "#newsletter") stay in the language being read.
const to = (href: string) => (href.startsWith('/') ? localPath(lang, href) : href);
const home = (await getEntry('pages', entryId('home', lang)))!.data;
// Jakarta's punctuation sits loose at display sizes; pull trailing , . back toward the word.
const escape = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const tight = (t: string) => escape(t).replace(/([,.;:?])/g, '<span class="punct">$1</span>');
---

<Base inkHead takePart={false}>
  <div class="hero-stage" data-hero-stage>
  <section class="hero" data-theme="ink" aria-labelledby="hero-title" data-hero>
    <div class="wrap hero__copy" data-hero-copy>
      <h1 id="hero-title" class="hero__title">
        <span class="hero__line" set:html={tight(home.headline)} />
        {home.headlineAccent && ' '}
        {home.headlineAccent && <span class="hero__line hero__accent" set:html={tight(home.headlineAccent)} />}
      </h1>
      <p class="lead hero__lead">{home.standfirst}</p>
      <NewsletterForm id="newsletter" label={home.newsletterLabel} button={home.newsletterButton} />
    </div>
    <div class="hero__scene" data-hero-scene>
      <Door class="hero__door" animate floor="long" />
      <Door class="hero__door" shut floor="none" />
      <Door class="hero__door" shut floor="none" />
    </div>
  </section>
  </div>

  <div class="ways-stage" data-ways-stage>
  <section class="ways" aria-labelledby="ways-title" data-ways>
    <div class="wrap">
      <h2 id="ways-title" class="ways__title">{home.doorwaysTitle}</h2>
      <ul class="ways__row">
        {
          home.doorways.map((way) => (
            <li class="way">
              <Door word={way.word} animate floor="long" />
              <div class="way__text">
                <h3>{way.title}</h3>
                <p>{way.body}</p>
                <a class="way__link" href={to(way.linkHref)}>
                  {way.linkLabel} <Arrow />
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  </div>

  <section class="promises" aria-labelledby="promises-title">
    <div class="wrap promises__grid">
      <h2 id="promises-title" class="promises__title">{home.promisesTitle}</h2>
      <ul class="promises__list">
        {
          home.promises.map((promise) => (
            <li>
              <h3>{promise.title}</h3>
              <p>{promise.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="why" data-theme="ink" aria-labelledby="why-title">
    <div class="wrap why__grid">
      <h2 id="why-title" class="why__statement" set:html={tight(home.whyQuote)} />
      <div class="why__body">
        <p>{home.whyBody}</p>
        <div class="why__links">
          <a class="way__link" href={to('/about/')}>{t.why} <Arrow /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="close" aria-labelledby="close-title">
    <div class="wrap close__grid">
      <h2 id="close-title" class="close__line" set:html={tight(home.closing)} />
      <div>
        <NewsletterForm id="newsletter-end" label={home.closingLabel} button={home.newsletterButton} />
        <p class="close__other" set:html={fill(t.also, { help: to('/contact/?reason=help'), host: to('/contact/?reason=host') })} />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero: night outside, light in the doorway. The statement up top, one big open door on the
     floor below it, more doors running off the right edge. */
  .hero {
    position: relative;
    overflow: clip;
    /* The header lies over the top of this field (Base, inkHead), so the hero is the whole screen. */
    min-height: 100svh;
    background: var(--hf-surface);
    color: var(--hf-text);
    padding-top: var(--head-h);
    padding-bottom: calc(var(--door) * 0.86 + 32px);
    --door: clamp(220px, 58vw, 380px);
  }
  .hero__copy {
    position: relative;
    z-index: 2;
    padding-top: clamp(24px, 5vh, 64px);
  }
  .hero__title {
    font-size: clamp(48px, 1.4rem + 5.2vw, 96px);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--hf-text);
  }
  .hero__line {
    display: block;
  }
  .hero__accent {
    color: var(--hf-sunrise);
    transition: color 620ms var(--ease-out) 300ms;
  }
  /* The second line catches the light as the door opens, in step with the leaf's swing. */
  :global(.motion) .hero:has(:global(.hero__door[data-animate]:not([data-opened]))) .hero__accent {
    color: var(--hf-text);
    transition-duration: 0ms;
  }
  .hero__lead {
    margin-top: clamp(20px, 3.5vh, 36px);
    margin-bottom: clamp(24px, 4vh, 40px);
    max-width: 30em;
  }
  .hero__scene {
    position: absolute;
    z-index: 1;
    left: var(--gutter);
    /* The door's viewBox ends one unit below its floor; sit the floor exactly on the edge. */
    bottom: calc(var(--door) / -60);
    display: flex;
    align-items: flex-end;
    width: max-content;
  }
  :global(.hero__door) {
    width: var(--door);
    flex: none;
  }
  /* Shut doors have no leaf showing, so close up the space it would take: a tighter colonnade. */
  .hero__scene > :global(.hero__door + .hero__door) {
    margin-left: calc(var(--door) * -0.3);
  }
  @media (min-width: 1100px) {
    .hero {
      --door: clamp(300px, min(38vw, 74vh), 600px);
      padding-bottom: 48px;
      display: grid;
      align-content: center;
    }
    .hero__copy {
      padding-top: 0;
      padding-bottom: 6vh;
    }
    .hero__lead,
    .hero__copy :global(.news) {
      max-width: min(520px, 40vw);
    }
    .hero__scene {
      left: 50%;
    }
  }

  /* Walk through the door. The hero holds still (sticky, so the browser does the holding) for
     1.2 screens of scrolling while a script walks into the doorway. The next section waits
     underneath, so when the light fades it is already there. */
  @media (min-width: 1100px) and (min-height: 700px) {
    :global(.motion) .hero-stage {
      position: relative;
      z-index: 2;
      height: 220svh;
      pointer-events: none;
    }
    :global(.motion) .hero {
      position: sticky;
      top: 0;
      height: 100svh;
      pointer-events: auto;
    }
    :global(.motion) .ways-stage {
      margin-top: -100svh;
    }
  }

  /* Three ways in: a colonnade. Each arch heads its own column; one floor runs under all three. */
  .ways {
    padding-block: var(--section);
    overflow: clip;
    background: var(--hf-cream);
  }
  /* The colonnade holds still while scrolling opens its doors. Only set by the script, and only
     when the whole section fits on screen. */
  :global(.crank) .ways-stage {
    height: 280svh;
  }
  :global(.crank) .ways {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    align-content: center;
    padding-block: 32px;
  }
  .ways__title {
    font-size: var(--size-display);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: clamp(32px, 5vh, 64px);
  }
  .ways__row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 4vw, 64px);
  }
  .way :global(.door) {
    width: min(100%, 300px);
    margin-bottom: 32px;
  }
  /* One floor under the whole row: only the first door draws it while they stand side by side. */
  @media (min-width: 821px) {
    .way:not(:first-child) :global(.door__ground) {
      display: none;
    }
  }
  .way__text {
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .way__text p {
    max-width: 34ch;
  }
  .way__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    justify-self: start;
    font: 700 17px/1.2 var(--font-brand);
    color: var(--hf-text);
    text-decoration-color: var(--hf-sunrise-deep);
  }
  [data-theme='ink'] .way__link {
    text-decoration-color: var(--hf-sunrise);
  }

  @media (max-width: 820px) {
    .ways__row {
      grid-template-columns: 1fr;
      gap: 72px;
    }
    .way :global(.door) {
      width: min(62vw, 260px);
    }
  }

  /* Four plain statements about what we are not, ruled like a contents page. */
  .promises {
    padding-block: 0 var(--section);
  }
  .promises__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 32px clamp(40px, 6vw, 96px);
  }
  .promises__title {
    font-size: var(--size-display);
    font-weight: 800;
    letter-spacing: -0.03em;
    max-width: 7em;
  }
  .promises__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px clamp(24px, 4vw, 56px);
  }
  .promises__list li {
    display: grid;
    gap: 10px;
    align-content: start;
    padding-top: 20px;
    border-top: 2px solid var(--hf-ink);
  }
  .promises__list p {
    max-width: 32ch;
  }
  @media (max-width: 820px) {
    .promises__grid,
    .promises__list {
      grid-template-columns: 1fr;
    }
  }

  /* Why: an ink field, answering the ink of the hero. */
  .why {
    background: var(--hf-surface);
    color: var(--hf-text);
    padding-block: var(--section);
  }
  .why__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 40px clamp(40px, 6vw, 96px);
    align-items: end;
  }
  .why__statement {
    font-size: clamp(30px, 1.2rem + 2.6vw, 58px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--hf-text);
  }
  .why__body {
    display: grid;
    gap: 20px;
    color: var(--hf-text);
  }
  .why__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 32px;
  }
  @media (max-width: 820px) {
    .why__grid {
      grid-template-columns: 1fr;
    }
  }

  .close {
    padding-block: var(--section);
  }
  .close__grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 40px clamp(40px, 6vw, 96px);
    align-items: end;
  }
  .close__line {
    font-size: var(--size-poster);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.035em;
    max-width: 8em;
  }
  .close__other {
    margin-top: 28px;
  }
  @media (max-width: 820px) {
    .close__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const root = document.documentElement;

  if (root.classList.contains('motion')) {
    gsap.registerPlugin(ScrollTrigger);

    // The hero door opens once the type has landed. CSS carries the swing.
    const heroDoor = document.querySelector<SVGElement>('.hero__door[data-animate]');
    if (heroDoor) {
      document.fonts.ready.then(() => {
        setTimeout(() => heroDoor.setAttribute('data-opened', ''), 280);
      });
    }

    // Walk through the door. CSS holds the hero still (sticky inside a tall stage); this only
    // maps how far you have scrolled through that stage onto the walk. Nothing is pinned by
    // script, so scrolling up and down can never leave the page in a half-moved state.
    const stage = document.querySelector<HTMLElement>('[data-hero-stage]');
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const scene = document.querySelector<HTMLElement>('[data-hero-scene]');
    const copy = document.querySelector<HTMLElement>('[data-hero-copy]');
    const mm = gsap.matchMedia();
    mm.add('(min-width: 1100px) and (min-height: 700px)', () => {
      if (!stage || !hero || !scene || !copy || !heroDoor) return;
      // The lit part of the doorway in the door's own units (viewBox 2 6 60 50): a point to walk
      // toward, and the edges the screen has to fit inside before the light counts as filling it.
      const LIGHT = { x: 40.75, y: 42, left: 30, right: 51.5, top: 32 };
      const measure = () => {
        gsap.set(scene, { clearProps: 'transform,transformOrigin' });
        const d = heroDoor.getBoundingClientRect();
        const h = hero.getBoundingClientRect();
        const sc = scene.getBoundingClientRect();
        const u = d.width / 60;
        const x = d.left + (LIGHT.x - 2) * u;
        const y = d.top + (LIGHT.y - 6) * u;
        const cover = Math.max(
          (x - h.left) / ((LIGHT.x - LIGHT.left) * u),
          (h.right - x) / ((LIGHT.right - LIGHT.x) * u),
          (y - h.top) / ((LIGHT.y - LIGHT.top) * u),
        );
        gsap.set(scene, { transformOrigin: `${x - sc.left}px ${y - sc.top}px` });
        return cover * 1.12;
      };
      let scale = measure();
      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        // Out of sight means out of reach: the form cannot take focus once it has faded.
        onUpdate: () => (copy.inert = tl.progress() > 0.25),
        scrollTrigger: {
          trigger: stage,
          start: 'top top',
          end: 'bottom bottom',
          scrub: 0.3,
          invalidateOnRefresh: true,
          onRefreshInit: () => (scale = measure()),
        },
      });
      tl.to(copy, { opacity: 0, y: -48, duration: 0.32, ease: 'power1.in' }, 0.05)
        .to(scene, { scale: () => scale, duration: 0.8, ease: 'power3.in', force3D: false }, 0)
        // The light fills the screen, then gives way to the room: the next section is already
        // in place underneath.
        .to(hero, { autoAlpha: 0, duration: 0.18 }, 0.8)
        .to({}, { duration: 0.02 });

      // Links to the sign-up form. The form lives in the held hero, so its place in the page
      // moves as you scroll; go to the top, where it is always in view, and put the cursor in it.
      const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[href$="#newsletter"]'));
      const toForm = (event?: Event) => {
        event?.preventDefault();
        window.scrollTo({ top: 0, behavior: 'instant' });
        ScrollTrigger.update();
        tl.scrollTrigger?.getTween()?.progress(1);
        tl.progress(0);
        copy.inert = false;
        copy.querySelector<HTMLInputElement>('input[type="email"]')?.focus({ preventScroll: true });
      };
      links.forEach((link) => link.addEventListener('click', toForm));
      if (location.hash === '#newsletter') requestAnimationFrame(() => toForm());

      return () => {
        links.forEach((link) => link.removeEventListener('click', toForm));
        copy.inert = false;
        gsap.set([scene, copy, hero], { clearProps: 'all' });
      };
    });

    // The colonnade. If the whole section fits on a large screen it holds still (sticky, in
    // CSS under .crank) and scrolling opens the three doors in turn. Otherwise each door simply
    // opens as it comes into view.
    const ways = document.querySelector<HTMLElement>('[data-ways]');
    const waysStage = document.querySelector<HTMLElement>('[data-ways-stage]');
    const doors = ways ? Array.from(ways.querySelectorAll<SVGElement>('.door')) : [];
    const texts = ways ? Array.from(ways.querySelectorAll<HTMLElement>('.way__text')) : [];
    const open = (door: SVGElement) => door.setAttribute('data-opened', '');
    const large = window.matchMedia('(min-width: 900px) and (min-height: 760px)');

    const fits = () => {
      const inner = ways?.firstElementChild as HTMLElement | null;
      if (!ways || !inner) return false;
      // 64: the section's own padding while it is held (see .crank .ways).
      return inner.offsetHeight + 64 <= window.innerHeight;
    };

    const crank = () => {
      root.classList.add('crank');
      doors.forEach((door) => {
        door.classList.add('is-scrubbed');
        door.style.setProperty('--p', '0');
        open(door);
      });
      // Dimmed, never faint: 0.7 keeps ink on cream above 4.5:1 while a door is still shut.
      gsap.set(texts, { opacity: 0.7, y: 14 });
      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: { trigger: waysStage, start: 'top top', end: 'bottom bottom', scrub: 0.3 },
      });
      // A beat with all three shut, then one after another.
      doors.forEach((door, i) => {
        tl.to(door, { '--p': 1, duration: 1 }, i + 0.2);
        tl.to(texts[i], { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, i + 0.55);
      });
      tl.to({}, { duration: 0.4 });
      return () => {
        tl.scrollTrigger?.kill();
        tl.kill();
        root.classList.remove('crank');
        doors.forEach((door) => {
          door.classList.remove('is-scrubbed');
          door.style.removeProperty('--p');
        });
        gsap.set(texts, { clearProps: 'opacity,transform' });
      };
    };

    const step = () => {
      const triggers = doors.map((door) =>
        ScrollTrigger.create({ trigger: door, start: 'top 78%', once: true, onEnter: () => open(door) }),
      );
      return () => triggers.forEach((t) => t.kill());
    };

    let mode = '';
    let undo = () => {};
    const choose = () => {
      if (!ways || !waysStage) return;
      const next = large.matches && fits() ? 'crank' : 'step';
      if (next === mode) return;
      undo();
      mode = next;
      undo = next === 'crank' ? crank() : step();
      ScrollTrigger.refresh();
    };
    choose();
    document.fonts.ready.then(choose);
    let resized = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resized);
      resized = window.setTimeout(choose, 200);
    });
  }
</script>

<style is:global>
  /* Scroll-scrubbed doors take their state from --p (0 shut, 1 open) instead of CSS transitions. */
  .punct {
    margin-left: -0.06em;
  }
  .door.is-scrubbed .door__shut,
  .door.is-scrubbed .door__leaf,
  .door.is-scrubbed .door__spill {
    transition: none;
  }
  .door.is-scrubbed .door__shut {
    transform: scaleX(clamp(0, 1 - var(--p) * 2, 1));
  }
  .door.is-scrubbed .door__leaf {
    transform: scaleX(clamp(0, var(--p) * 2 - 1, 1));
  }
  .door.is-scrubbed .door__spill {
    transition: none;
    transform: scaleY(clamp(0, var(--p) * 2, 1));
  }
  .door.is-scrubbed .door__word--shut {
    transition: none;
    opacity: clamp(0, 1 - var(--p) * 6, 1);
  }
</style>
