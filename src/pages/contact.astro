---
import Base from '../layouts/Base.astro';

const reasons = [
  { value: 'come', label: 'Come to a workshop' },
  { value: 'help', label: 'Help run one' },
  { value: 'host', label: 'Offer a room' },
  { value: 'write', label: 'Write something with us' },
  { value: 'press', label: 'Press or partnership' },
  { value: 'other', label: 'Something else' },
];
---

<Base title="Contact" description="Get in touch with Human First AI.">
  <header class="wrap page-head">
    <h1>Say hello</h1>
    <p class="lead">A real person reads every message. We are volunteers, so it may take a few days to reply.</p>
  </header>

  <div class="wrap contact">
    <form
      class="contact__form"
      name="contact"
      method="POST"
      action="/thanks/"
      data-netlify="true"
      netlify-honeypot="company"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="visually-hidden">
        <label>Leave this empty <input name="company" tabindex="-1" autocomplete="off" /></label>
      </p>

      <fieldset class="field reasons">
        <legend>What would you like to do?</legend>
        <div class="reasons__grid">
          {
            reasons.map((r, i) => (
              <label class="reason">
                <input type="radio" name="reason" value={r.value} required checked={i === 0} />
                <span>{r.label}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="contact__pair">
        <div class="field">
          <label for="c-name">Your name</label>
          <input id="c-name" type="text" name="name" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="c-email">Email</label>
          <input id="c-email" type="email" name="email" autocomplete="email" required />
        </div>
      </div>

      <div class="field">
        <label for="c-message">Your message</label>
        <textarea id="c-message" name="message" required placeholder="Where you are, what you have in mind, any questions."></textarea>
      </div>

      <button class="btn" type="submit">Send message</button>
    </form>
  </div>
</Base>

<style>
  .contact {
    padding-bottom: var(--section);
  }
  .contact__form {
    display: grid;
    gap: 28px;
    max-width: 760px;
  }
  .contact__form .btn {
    justify-self: start;
  }
  .reasons {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .reasons legend {
    margin-bottom: 12px;
  }
  .reasons__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 10px;
  }
  .reason {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    padding: 12px 16px;
    border: 2px solid var(--hf-border);
    border-radius: var(--radius);
    background: var(--hf-white);
    font: 600 16px/1.3 var(--font-brand);
    cursor: pointer;
    transition:
      border-color 150ms var(--ease-out),
      background-color 150ms var(--ease-out);
  }
  .reason:hover {
    border-color: var(--hf-ink);
  }
  .reason:has(input:checked) {
    border-color: var(--hf-ink);
    background: var(--hf-sunrise);
  }
  .reason input {
    width: 20px;
    height: 20px;
    margin: 0;
    accent-color: var(--hf-ink);
  }
  .contact__pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  @media (max-width: 640px) {
    .contact__pair {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Links like /contact/?reason=host arrive with the right option chosen.
  const reason = new URLSearchParams(location.search).get('reason');
  if (reason) {
    const input = document.querySelector<HTMLInputElement>(`input[name="reason"][value="${CSS.escape(reason)}"]`);
    if (input) input.checked = true;
  }
</script>
