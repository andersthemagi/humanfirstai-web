---
import '../styles/global.css';
import TakePart from '../components/TakePart.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { languages, langs, defaultLang, langOf, localPath, pathWithoutLang, useT } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  /** Sets the header on Deep Ink, for pages whose first section is ink. */
  inkHead?: boolean;
  /** The "Take part" band above the footer. Off on pages that already end on their own next step. */
  takePart?: boolean;
  /** Keep the page out of search results (the thank-you page). */
  noindex?: boolean;
  /** Where the language links go, without a language on the front. Defaults to this page. */
  switchPath?: string;
  /** Off for a page that exists in one language only, so search engines are not sent to pages that are not there. */
  translated?: boolean;
}

const lang = langOf(Astro.url);
const t = useT(lang);

const {
  inkHead = false,
  takePart = true,
  noindex = false,
  translated = true,
  title,
  description = t.description,
  switchPath = translated ? pathWithoutLang(Astro.url) : '/',
} = Astro.props;

const pageTitle = title ? `${title} · Human First AI` : t.titleDefault;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const to = (href: string) => localPath(lang, href);

const nav = [
  { href: to('/about/'), label: t.nav.about },
  { href: to('/events/'), label: t.nav.events },
  { href: to('/blog/'), label: t.nav.blog },
  { href: to('/contact/'), label: t.nav.contact },
];
// The one step we most want people to take, named the same way everywhere.
const cta = { href: to('/#newsletter'), label: t.cta };
const isCurrent = (href: string) => path === href.replace(/\/$/, '') || path.startsWith(href);
// A draft put up for people to click through (SITE_DRAFT=1 at build) stays out of search results.
const draft = process.env.SITE_DRAFT === '1';
const canonical = new URL(Astro.url.pathname, Astro.site);
// The same page in each language, for search engines. English is the one to fall back on.
const alternates =
  translated && !noindex ? langs.map((code) => ({ code, href: new URL(localPath(code, switchPath), Astro.site) })) : [];
// The card shown when a link to the site is shared. public/og.png, 1200 × 630.
const shareImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {(noindex || draft) && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(localPath(defaultLang, switchPath), Astro.site)} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Human First AI" />
    <meta property="og:locale" content={languages[lang].og} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={useT(defaultLang).shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#FFF6EC" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      // Motion is an enhancement: only mark the page for it when the reader has not asked
      // their system to reduce motion. Without this class every door is drawn open.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>

    <header class="site-head" data-theme={inkHead ? 'ink' : undefined}>
      <div class="wrap site-head__inner">
        <a class="site-head__mark" href={to('/')} aria-label={t.homeLabel}>
          <img src={inkHead ? '/brand/hfai-horizontal-reversed.svg' : '/brand/hfai-horizontal-full.svg'} alt="" width="1154" height="159" />
        </a>

        <nav class="site-nav" aria-label={t.aria.main}>
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <LangSwitch class="site-head__lang" path={switchPath} />

        <a class="btn site-head__cta" href={cta.href}>{cta.label}</a>

        <details class="site-menu">
          <summary>{t.menu}</summary>
          <div class="site-menu__panel">
            <ul>
              {
                nav.map((item) => (
                  <li>
                    <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
              <li><a class="btn" href={cta.href}>{cta.label}</a></li>
            </ul>
            <LangSwitch class="site-menu__lang" path={switchPath} />
          </div>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
      {takePart && <TakePart />}
    </main>

    <footer class="site-foot" data-theme="ink">
      <div class="wrap site-foot__inner">
        <div class="site-foot__about">
          <img src="/brand/hfai-horizontal-reversed.svg" alt="Human First AI" width="1154" height="159" />
          <p>{t.footLine}</p>
          <LangSwitch class="site-foot__lang" path={switchPath} />
        </div>
        <nav aria-label={t.aria.footer}>
          <ul>
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            <li><a href={cta.href}>{cta.label}</a></li>
            <li><a href={to('/privacy/')}>{t.privacy}</a></li>
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -100px;
    z-index: 20;
    padding: 12px 16px;
    background: var(--hf-ink);
    color: var(--hf-cream);
    font: 700 16px/1 var(--font-brand);
    border-radius: var(--radius);
  }
  .skip:focus {
    top: 16px;
  }

  .site-head {
    position: relative;
    z-index: 10;
    background: var(--hf-surface);
    color: var(--hf-text);
  }
  /* On a page that opens on ink, the header lies over the top of that field. */
  .site-head[data-theme='ink'] {
    position: absolute;
    inset: 0 0 auto;
    background: none;
  }
  .site-head__inner {
    display: flex;
    align-items: center;
    gap: 32px;
    min-height: var(--head-h);
  }
  .site-head__mark {
    display: block;
    margin-right: auto;
    view-transition-name: site-mark;
  }
  .site-head__mark img {
    width: auto;
    height: 32px;
  }

  .site-nav ul,
  .site-menu ul,
  .site-foot ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav ul {
    display: flex;
    gap: 4px;
  }
  .site-nav a,
  .site-menu a:not(.btn) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    color: var(--hf-text);
    font: 600 16px/1 var(--font-brand);
    text-decoration: none;
  }
  .site-nav a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .site-nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-decoration-color: var(--hf-text-accent);
  }

  .site-head__cta {
    min-height: 46px;
    padding-inline: 18px;
    font-size: 16px;
  }

  .site-menu {
    display: none;
    position: relative;
  }
  .site-menu summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 2px currentColor;
    font: 700 16px/1 var(--font-brand);
    cursor: pointer;
    list-style: none;
  }
  .site-menu summary::-webkit-details-marker {
    display: none;
  }
  .site-menu[open] summary {
    background: var(--hf-text);
    color: var(--hf-surface);
  }
  .site-menu__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    min-width: 220px;
    padding: 10px;
    background: var(--hf-white);
    --hf-text: var(--hf-ink);
    --hf-surface: var(--hf-white);
    border-radius: 14px;
    box-shadow: 0 18px 40px -12px rgb(31 42 68 / 0.35);
  }
  .site-menu ul {
    display: grid;
    gap: 2px;
  }
  .site-menu :global(.site-menu__lang) {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid var(--hf-border);
  }
  .site-menu .btn {
    margin-top: 8px;
    width: 100%;
  }

  /* Four links, three languages and the button need this much room in Spanish and Catalan.
     Below it they fold into the menu. */
  @media (max-width: 1160px) {
    .site-nav,
    .site-head :global(.site-head__lang) {
      display: none;
    }
    .site-menu {
      display: block;
    }
    .site-head__inner {
      gap: 12px;
    }
    .site-head__mark img {
      height: 26px;
    }
  }
  /* On a phone there is no room for the button beside the mark; it is the last line of the menu. */
  @media (max-width: 620px) {
    .site-head__cta {
      display: none;
    }
  }
  @media (min-width: 621px) {
    .site-menu li:has(.btn) {
      display: none;
    }
  }

  .site-foot {
    background: var(--hf-surface);
    color: var(--hf-text);
    padding-block: 64px 40px;
  }
  .site-foot__inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 40px 64px;
  }
  .site-foot__about img {
    width: auto;
    height: 30px;
    margin-bottom: 20px;
  }
  .site-foot__about p {
    max-width: 30em;
    color: var(--hf-text-muted);
  }
  .site-foot :global(.site-foot__lang) {
    margin-top: 16px;
    margin-left: -6px;
  }
  .site-foot ul {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    gap: 4px 40px;
  }
  .site-foot a {
    color: var(--hf-text);
  }
  .site-foot nav a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    font: 600 16px/1 var(--font-brand);
    text-decoration: none;
  }
  .site-foot nav a:hover {
    text-decoration: underline;
  }
  @media (max-width: 720px) {
    .site-foot__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
