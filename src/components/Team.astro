---
// Our team, on the About page. Everyone gets the same card and nobody gets a title: an arch with
// their photo, or their initial until there is a photo they have agreed to, their name and a link.
import { getCollection, render } from 'astro:content';
import { defaultLang, fill, langOf, useT } from '../i18n/ui';

const lang = langOf(Astro.url);
const t = useT(lang);

const people = await Promise.all(
  (await getCollection('team'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (person) => ({ ...person, Content: (await render(person)).Content, hasBio: Boolean(person.body?.trim()) })),
);
const onLinkedIn = (link: string) => new URL(link).hostname.endsWith('linkedin.com');
const first = (name: string) => name.split(' ')[0];
// Photo descriptions are written in English in the CMS. The other languages get a plain one.
const altFor = (p: (typeof people)[number]) =>
  lang === defaultLang ? (p.data.photoAlt ?? '') : fill(t.team.portrait, { name: first(p.data.name) });
---

<section class="team" id="team" aria-labelledby="team-title">
  <h2 id="team-title">{t.team.title}</h2>
  <p class="lead team__lead">{fill(t.team.lead, { n: people.length })}</p>

  <ul class="team__row">
    {
      people.map((p) => (
        <li class="person">
          <div class="person__arch">
            {p.data.photo ? (
              <img src={p.data.photo} alt={altFor(p)} width="400" height="400" loading="lazy" />
            ) : (
              <span class="person__initial" aria-hidden="true">
                {p.data.name.charAt(0)}
              </span>
            )}
          </div>
          <h3 class="person__name">{p.data.name}</h3>
          {p.hasBio && (
            <div class="person__bio">
              <p.Content />
            </div>
          )}
          {p.data.link && (
            <a class="person__link" href={p.data.link}>
              {fill(onLinkedIn(p.data.link) ? t.team.onLinkedIn : t.team.more, { name: first(p.data.name) })}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .team {
    padding-bottom: var(--section);
  }
  .team h2 {
    font-size: var(--size-display);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .team__lead {
    margin-top: 16px;
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .team__row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px clamp(20px, 3vw, 40px);
  }
  @media (min-width: 640px) {
    .team__row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  /* The whole team in one row, nobody left over on a line of their own. */
  @media (min-width: 1000px) {
    .team__row {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  /* Portraits sit in the threshold arch: width : springline : radius = 30 : 21.5 : 15. */
  .person__arch {
    position: relative;
    aspect-ratio: 30 / 36.5;
    border-radius: 50% 50% 0 0 / 41.1% 41.1% 0 0;
    overflow: hidden;
    background: var(--hf-sky);
  }
  .person__arch img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .person__arch::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 6px;
    background: var(--hf-ink);
  }
  .person__initial {
    display: grid;
    place-items: center;
    height: 100%;
    font: 800 clamp(72px, 9vw, 112px) / 1 var(--font-brand);
    letter-spacing: -0.04em;
    color: var(--hf-ink);
  }
  .person__name {
    margin-top: 20px;
    font-size: var(--size-title);
  }
  .person__bio {
    margin-top: 12px;
  }
  .person__link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }
</style>
