---
// The Open Door, drawn from the mark's own geometry (brand/logo, 30 : 21.5 : 15), except the leaf.
// Default state is open, so the finished picture is in the HTML. Scripts may shut a
// door first and then open it (data-animate + data-opened); without them nothing is hidden.
interface Props {
  word?: string;
  shut?: boolean;
  /** Starts shut when motion is allowed and a script will open it. */
  animate?: boolean;
  /**
   * How far the floor runs. 'mark' is the logo's own ground; 'long' runs past both edges for a
   * row of doors on one floor ('none' on the others in that row, so no seams show).
   */
  floor?: 'mark' | 'long' | 'none';
  class?: string;
}
const { word, shut = false, animate = false, floor = 'mark', class: className } = Astro.props;
const ground = floor === 'long' ? { x: -600, width: 1264 } : { x: 3, width: 58 };
const OPENING = 'M27,51.5 L27,30 A12.5,12.5 0 0 1 52,30 L52,51.5 Z';
// The same opening seen at the back of a thick wall, offset so the inner jamb and the underside
// of the arch show as a darker crescent. The frame stroke hides its overhang on the right.
const FAR = 'M29.4,51.5 L29.4,31.2 A12.5,12.5 0 0 1 54.4,31.2 L54.4,51.5 Z';
// The leaf is that same arched door, swung 66 degrees toward you about its hinge and seen from the
// ground line, so the threshold stays level and the arch rises toward the near edge. This is where
// the drawing leaves the mark, whose leaf is flat-topped: a door cannot be arched shut and square open.
const LEAF =
  'M21.4,51.5 L21.4,30 C21.4,28.36 21.27,26.67 21.02,25.02 C20.76,23.37 20.38,21.76 19.89,20.28 C19.4,18.8 18.8,17.47 18.11,16.36 C17.43,15.26 16.66,14.41 15.86,13.88 C15.06,13.36 14.22,13.17 13.41,13.38 C12.61,13.59 11.84,14.2 11.17,15.2 C10.51,16.2 9.96,17.58 9.58,19.25 C9.2,20.91 9,22.85 9,24.88 L9,51.5 Z';
// Its far face, one thickness behind. What shows past the leaf is the edge and the rim of the arch.
const LEAF_BACK =
  'M19.48,51.5 L19.48,30.15 C19.48,28.53 19.34,26.85 19.08,25.21 C18.82,23.57 18.43,21.97 17.92,20.51 C17.42,19.04 16.8,17.72 16.09,16.63 C15.39,15.54 14.6,14.69 13.78,14.18 C12.95,13.66 12.09,13.48 11.26,13.69 C10.43,13.9 9.64,14.51 8.96,15.51 C8.28,16.5 7.71,17.87 7.32,19.53 C6.94,21.18 6.73,23.1 6.73,25.11 L6.73,51.5 Z';
---

<svg
  class:list={['door', className]}
  viewBox="2 6 60 50"
  overflow="visible"
  aria-hidden="true"
  focusable="false"
  data-door
  data-shut={shut ? '' : undefined}
  data-animate={animate ? '' : undefined}
>
  <path class="door__reveal" d={OPENING}></path>
  <path class="door__light" d={FAR}></path>
  {word && <text class="door__word" x="39.5" y="43">{word}</text>}
  <g class="door__shut">
    <path d={OPENING}></path>
    {word && <text class="door__word door__word--shut" x="39.5" y="43">{word}</text>}
    <circle class="door__knob" cx="47.6" cy="36" r="1.5"></circle>
  </g>
  <path class="door__frame" d="M24.5,51.5 L24.5,30 A15,15 0 0 1 54.5,30 L54.5,51.5"></path>
  <g class="door__leaf">
    <path class="door__edge" d={LEAF_BACK}></path>
    <path d={LEAF}></path>
    <circle class="door__knob" cx="11.6" cy="33.1" r="1.8"></circle>
  </g>
  {floor !== 'none' && <rect class="door__ground" x={ground.x} y="51.2" width={ground.width} height="3.8"></rect>}
  <!-- Light poured out over the threshold. After the ground, or the floor would cover it. -->
  <path class="door__spill" d="M27,51.2 L52,51.2 L56.6,55 L24.2,55 Z"></path>
</svg>

<style is:global>
  .door {
    width: 100%;
    height: auto;
  }
  .door__light,
  .door__spill {
    fill: var(--hf-sunrise);
  }
  .door__reveal {
    fill: var(--hf-sunrise-deep);
  }
  .door__shut path {
    /* Covers the antialiased edge of the light beneath, so no hairline shows. */
    stroke: var(--hf-text);
    stroke-width: 0.8;
  }
  /* Doors draw in the text colour of whatever they stand on: ink on cream, cream on ink. */
  .door__shut path,
  .door__leaf path,
  .door__ground {
    fill: var(--hf-text);
  }
  /* The leaf's thickness, in shade: the door's own colour, a step toward whatever it stands on. */
  .door__leaf .door__edge {
    fill: color-mix(in oklab, var(--hf-text) 68%, var(--hf-surface));
  }
  .door__frame {
    fill: none;
    stroke: var(--hf-text);
    stroke-width: 5;
  }
  .door__knob {
    fill: var(--hf-sunrise);
  }
  .door__word {
    font-family: var(--font-brand);
    font-weight: 800;
    font-size: 6.4px;
    letter-spacing: -0.02em;
    text-anchor: middle;
    fill: var(--hf-ink);
  }
  .door__word--shut {
    fill: var(--hf-surface);
    opacity: 0;
    transition: opacity 120ms linear;
  }
  /* The painted word on the shut face leaves before the door folds, so it never squashes. */
  .door[data-shut] .door__word--shut,
  .motion .door[data-animate]:not([data-opened]) .door__word--shut {
    opacity: 1;
  }

  /* The swing: the shut door folds to its hinge, then the leaf opens toward you. */
  .door__shut,
  .door__leaf,
  .door__spill {
    transform-box: fill-box;
  }
  /* Light pours over the threshold as the door unlatches, before the leaf swings. */
  .door__spill {
    transform-origin: center top;
    transform: scaleY(1);
    transition: transform 380ms cubic-bezier(0.55, 0, 0.8, 0.2);
  }
  .door[data-shut] .door__spill,
  .motion .door[data-animate]:not([data-opened]) .door__spill {
    transform: scaleY(0);
    transition-duration: 0ms;
  }
  .door__shut {
    transform-origin: left center;
    transform: scaleX(0);
    transition: transform 380ms cubic-bezier(0.55, 0, 0.8, 0.2);
  }
  .door__leaf {
    transform-origin: right center;
    transform: scaleX(1);
    transition: transform 620ms var(--ease-out) 300ms;
  }
  .door[data-shut] .door__shut,
  .motion .door[data-animate]:not([data-opened]) .door__shut {
    transform: scaleX(1);
    transition-delay: 0ms;
  }
  .door[data-shut] .door__leaf,
  .motion .door[data-animate]:not([data-opened]) .door__leaf {
    transform: scaleX(0);
    transition-duration: 200ms;
    transition-delay: 0ms;
  }
</style>
