---
// The four next steps, one per kind of visitor. Base puts this above the footer on every page
// that does not already end on its own ask, so no page is a dead end.
import Arrow from './Arrow.astro';

const steps = [
  {
    title: 'Come to a workshop',
    body: 'Leave your email and we will tell you when and where the first one is.',
    link: 'Tell me when',
    href: '/#newsletter',
  },
  {
    title: 'Help run one',
    body: 'Teach, translate or set up the room. Nobody runs their first one alone.',
    link: 'Offer to help',
    href: '/contact/?reason=help',
  },
  {
    title: 'Lend a room',
    body: 'A library, a hall, a quiet café. Chairs, a few plugs and wifi are enough.',
    link: 'Offer a room',
    href: '/contact/?reason=host',
  },
  {
    title: 'Back this work',
    body: 'If you or your organisation could help cover what the workshops cost, talk to us.',
    link: 'Talk to us',
    href: '/contact/?reason=fund',
  },
];
---

<section class="take" aria-labelledby="take-title">
  <div class="wrap">
    <h2 id="take-title" class="take__title">Take part</h2>
    <ul class="take__list">
      {
        steps.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
            <a class="take__link" href={step.href}>
              {step.link} <Arrow />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .take {
    padding-bottom: var(--section);
  }
  .take__title {
    font-size: var(--size-display);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  .take__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px clamp(24px, 3vw, 48px);
  }
  .take__list li {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 10px;
    padding-top: 20px;
    border-top: 2px solid var(--hf-ink);
  }
  .take__list p {
    max-width: 32ch;
  }
  .take__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    justify-self: start;
    font: 700 17px/1.2 var(--font-brand);
    color: var(--hf-text);
    text-decoration-color: var(--hf-sunrise-deep);
  }
  @media (max-width: 1000px) {
    .take__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .take__list {
      grid-template-columns: 1fr;
    }
  }
</style>
