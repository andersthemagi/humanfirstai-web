---
// The three next steps, one per kind of visitor. Base puts this above the footer on every page
// that does not already end on its own ask, so no page is a dead end.
import Arrow from './Arrow.astro';
import { langOf, localPath, useT } from '../i18n/ui';

const lang = langOf(Astro.url);
const t = useT(lang);
// The words are in src/i18n/ui.ts; where each step leads is fixed here.
const hrefs = ['/#newsletter', '/contact/?reason=help', '/contact/?reason=host'];
const steps = t.take.steps.map((step, i) => ({ ...step, href: localPath(lang, hrefs[i]) }));
---

<section class="take" aria-labelledby="take-title">
  <div class="wrap">
    <h2 id="take-title" class="take__title">{t.take.title}</h2>
    <ul class="take__list">
      {
        steps.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
            <a class="take__link" href={step.href}>
              {step.link} <Arrow />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .take {
    padding-bottom: var(--section);
  }
  .take__title {
    font-size: var(--size-display);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  .take__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px clamp(24px, 3vw, 48px);
  }
  .take__list li {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 10px;
    padding-top: 20px;
    border-top: 2px solid var(--hf-ink);
  }
  .take__list p {
    max-width: 32ch;
  }
  .take__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    justify-self: start;
    font: 700 17px/1.2 var(--font-brand);
    color: var(--hf-text);
    text-decoration-color: var(--hf-sunrise-deep);
  }
  @media (max-width: 760px) {
    .take__list {
      grid-template-columns: 1fr;
    }
  }
</style>
