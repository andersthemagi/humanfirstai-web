---
// Drawn arrow for "go somewhere" links. External links tilt up and to the right.
interface Props {
  external?: boolean;
}
const { external = false } = Astro.props;
---

<svg class="arrow" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
  {
    external ? (
      <path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    ) : (
      <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    )
  }
</svg>

<style>
  .arrow {
    display: inline-block;
    flex: none;
    vertical-align: -0.12em;
    transition: transform 180ms var(--ease-out);
  }
  :global(a:hover) > .arrow {
    transform: translateX(3px);
  }
</style>
